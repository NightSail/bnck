# Leaf pages use file paths; directory-style URLs redirect to them.
/about/ /about 301
/dataset/ /dataset 301

/data https://github.com/NightSail/bnck/releases/ 302
/data/ https://github.com/NightSail/bnck/releases/ 302
/data/latest https://github.com/NightSail/bnck/releases/tag/bnck-dataset-{{release}} 302
/data/latest/ https://github.com/NightSail/bnck/releases/tag/bnck-dataset-{{release}} 302
/data/latest/* https://github.com/NightSail/bnck/releases/download/bnck-dataset-{{release}}/:splat 302
/data/:release https://github.com/NightSail/bnck/releases/tag/bnck-dataset-:release 301
/data/:release/ https://github.com/NightSail/bnck/releases/tag/bnck-dataset-:release 301
/data/:release/* https://github.com/NightSail/bnck/releases/download/bnck-dataset-:release/:splat 301

/short/:section/ /short/:section 301
/projects/:project/ /projects/:project 301
/executables/:executable/ /executables/:executable 301

# Identity pages are rendered from the browser dataset by one shared shell.
# Old per-object JSON export paths now open the identity page instead.
/projects/:project/providers.json /projects/:project 301
/executables/:executable/providers.json /executables/:executable 301
/projects/* /identity.html 200
/executables/* /identity.html 200
